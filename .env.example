# GEMINI_API_KEY: Used in cloud/sandbox environments when local Ollama is not running.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OLLAMA CONFIGURATION: Optional local LLM provider (prioritized automatically if reachable or if LLM_PROVIDER=ollama).
# Run `ollama pull qwen3:8b` locally to use Qwen3:8b as the local planner/executor LLM.
LLM_PROVIDER="auto"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"

# SQLITE_DB_PATH: Path to persistent SQLite database file.
SQLITE_DB_PATH="./data/taxshield.sqlite"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
